# Katachi Generator Environment Configuration

# Server port (Railway will override this)
PORT=3001

# Arweave wallet JSON (for Railway deployment - paste your wallet JSON as a single line string)
# ARWEAVE_WALLET={"kty":"RSA","n":"...your wallet JSON here...","e":"AQAB",...}

# Local development - wallet file path (fallback if ARWEAVE_WALLET env var not set)
# The app will automatically use ./keys/arweave-wallet.json if ARWEAVE_WALLET env var is not present

# HTML file handling (always save locally + upload to R2)
# TESTING_MODE is computed from NODE_ENV in server

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_ACCESS_KEY_SECRET=your-r2-access-key-secret
R2_BUCKET_NAME=katachi-gen
R2_PUBLIC_URL=https://public-bucket-url.example.com

# Rarible API Key for fetching optimized NFT thumbnails
RARIBLE_API_KEY=your-rarible-api-key

# Alchemy API for optimized NFT thumbnails
ALCHEMY_API_KEY=your-alchemy-api-key